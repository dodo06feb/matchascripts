-- ==========================================
-- DRAWING HELPERS
-- ==========================================

local function rect(x, y, w, h, color)
    local obj = Drawing.new("Square")

    obj.Position = Vector2.new(x, y)
    obj.Size = Vector2.new(w, h)
    obj.Color = color
    obj.Filled = true
    obj.Transparency = 1
    obj.Visible = true

    return obj
end

local function circle(x, y, radius, color)
    local obj = Drawing.new("Circle")

    obj.Position = Vector2.new(x, y)
    obj.Radius = radius
    obj.Color = color
    obj.Filled = true
    obj.Transparency = 1
    obj.Visible = true

    return obj
end

local function roundedBox(x, y, w, h, radius, color)
    local parts = {}

    parts[1] = rect(
        x + radius,
        y,
        math.max(1, w - radius * 2),
        h,
        color
    )

    parts[2] = rect(
        x,
        y + radius,
        w,
        math.max(1, h - radius * 2),
        color
    )

    parts[3] = circle(
        x + radius,
        y + radius,
        radius,
        color
    )

    parts[4] = circle(
        x + w - radius,
        y + radius,
        radius,
        color
    )

    parts[5] = circle(
        x + radius,
        y + h - radius,
        radius,
        color
    )

    parts[6] = circle(
        x + w - radius,
        y + h - radius,
        radius,
        color
    )

    return parts
end

local function createText(value, x, y, size, color)
    local obj = Drawing.new("Text")

    obj.Text = value
    obj.Position = Vector2.new(x, y)
    obj.Size = size
    obj.Color = color or TEXT_COLOR
    obj.Outline = true
    obj.Visible = true

    return obj
end

local function addGroup(name, parts)
    GUI[name] = parts
end

local function setGroupVisible(group, state)
    if not group then
        return
    end

    for _, object in pairs(group) do
        object.Visible = state
    end
end

local function inside(x, y, px, py, pw, ph)
    return x >= px
       and x <= px + pw
       and y >= py
       and y <= py + ph
end

local function moveGroup(group, dx, dy)
    if not group then
        return
    end

    for _, object in pairs(group) do
        local pos = object.Position

        object.Position = Vector2.new(
            pos.X + dx,
            pos.Y + dy
        )
    end
end

