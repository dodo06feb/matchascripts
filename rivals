-- ==========================================
-- DRAGGING
-- Works normal + compact
-- ==========================================

local dragging = false
local dragOffsetX = 0
local dragOffsetY = 0

local function moveGUI(newX, newY)

    local dx = newX - X
    local dy = newY - Y

    X = newX
    Y = newY

    SETTINGS_Y = Y + 130

    for _, object in pairs(GUI) do

        if type(object) == "table" then

            moveGroup(
                object,
                dx,
                dy
            )

        else

            local pos =
                object.Position

            object.Position =
                Vector2.new(
                    pos.X + dx,
                    pos.Y + dy
                )
        end
    end
end

task.spawn(function()

    while RUNNING do

        if OPEN and not ANIMATING then

            local mouseX = Mouse.X
            local mouseY = Mouse.Y

            local dragWidth =
                COMPACT
                and COMPACT_W
                or W

            local dragHeight =
                COMPACT
                and COMPACT_H
                or 58

            if not dragging
            and ismouse1pressed()
            and inside(
                mouseX,
                mouseY,
                X,
                Y,
                dragWidth,
                dragHeight
            ) then

                dragging = true

                dragOffsetX =
                    mouseX - X

                dragOffsetY =
                    mouseY - Y
            end

            if dragging then

                if ismouse1pressed() then

                    moveGUI(
                        mouseX - dragOffsetX,
                        mouseY - dragOffsetY
                    )

                else

                    dragging = false
                end
            end
        end

        task.wait(0.01)
    end
end)

