-- ==========================================
-- NORMAL / COMPACT
-- ==========================================

local function setNormalVisible(state)

    for name, object in pairs(GUI) do

        if name ~= "CompactShadow"
        and name ~= "CompactBackground"
        and name ~= "CompactAccent"
        and name ~= "CompactTitle"
        and name ~= "CompactStatus" then

            if type(object) == "table" then
                setGroupVisible(object, state)
            else
                object.Visible = state
            end
        end
    end

    if state then

        if CURRENT_PAGE == "Misc" then
            setMiscPage()

        elseif CURRENT_PAGE == "Settings" then
            setSettingsPage()

        else
            setMainPage()
        end
    end
end

local function setCompactVisible(state)

    setGroupVisible(
        GUI.CompactShadow,
        state
    )

    setGroupVisible(
        GUI.CompactBackground,
        state
    )

    GUI.CompactAccent.Visible = state
    GUI.CompactTitle.Visible = state
    GUI.CompactStatus.Visible = state
end

local function easeOutCubic(t)
    return 1 - ((1 - t) ^ 3)
end

-- ==========================================
-- COMPACT
-- ==========================================

local function animateToCompact()

    if ANIMATING or COMPACT then
        return
    end

    ANIMATING = true

    setNormalVisible(false)
    setCompactVisible(true)

    local duration = 0.30
    local startTime = os.clock()

    while true do

        local elapsed =
            os.clock() - startTime

        local t =
            math.clamp(
                elapsed / duration,
                0,
                1
            )

        t = easeOutCubic(t)

        local currentW =
            W + (COMPACT_W - W) * t

        local currentH =
            H + (COMPACT_H - H) * t

        local bg =
            GUI.CompactBackground

        bg[1].Position =
            Vector2.new(
                X + R,
                Y
            )

        bg[1].Size =
            Vector2.new(
                math.max(
                    1,
                    currentW - R * 2
                ),
                currentH
            )

        bg[2].Position =
            Vector2.new(
                X,
                Y + R
            )

        bg[2].Size =
            Vector2.new(
                currentW,
                math.max(
                    1,
                    currentH - R * 2
                )
            )

        bg[3].Position =
            Vector2.new(
                X + R,
                Y + R
            )

        bg[4].Position =
            Vector2.new(
                X + currentW - R,
                Y + R
            )

        bg[5].Position =
            Vector2.new(
                X + R,
                Y + currentH - R
            )

        bg[6].Position =
            Vector2.new(
                X + currentW - R,
                Y + currentH - R
            )

        GUI.CompactTitle.Position =
            Vector2.new(
                X + 18,
                Y + math.floor(
                    currentH / 2 - 10
                )
            )

        GUI.CompactStatus.Position =
            Vector2.new(
                X + currentW - 22,
                Y + currentH / 2
            )

        if t >= 1 then
            break
        end

        task.wait()
    end

    COMPACT = true
    ANIMATING = false
end

-- ==========================================
-- EXPAND
-- ==========================================

local function animateToFull()

    if ANIMATING or not COMPACT then
        return
    end

    ANIMATING = true

    local duration = 0.30
    local startTime = os.clock()

    local startDodoX =
        X + 18

    local startDodoY =
        Y + math.floor(
            COMPACT_H / 2 - 10
        )

    local targetDodoX =
        X + 22

    local targetDodoY =
        Y + 17

    while true do

        local elapsed =
            os.clock() - startTime

        local t =
            math.clamp(
                elapsed / duration,
                0,
                1
            )

        t = easeOutCubic(t)

        local currentW =
            COMPACT_W +
            (W - COMPACT_W) * t

        local currentH =
            COMPACT_H +
            (H - COMPACT_H) * t

        local bg =
            GUI.CompactBackground

        bg[1].Position =
            Vector2.new(
                X + R,
                Y
            )

        bg[1].Size =
            Vector2.new(
                math.max(
                    1,
                    currentW - R * 2
                ),
                currentH
            )

        bg[2].Position =
            Vector2.new(
                X,
                Y + R
            )

        bg[2].Size =
            Vector2.new(
                currentW,
                math.max(
                    1,
                    currentH - R * 2
                )
            )

        bg[3].Position =
            Vector2.new(
                X + R,
                Y + R
            )

        bg[4].Position =
            Vector2.new(
                X + currentW - R,
                Y + R
            )

        bg[5].Position =
            Vector2.new(
                X + R,
                Y + currentH - R
            )

        bg[6].Position =
            Vector2.new(
                X + currentW - R,
                Y + currentH - R
            )

        GUI.CompactTitle.Position =
            Vector2.new(
                startDodoX +
                (targetDodoX - startDodoX) * t,

                startDodoY +
                (targetDodoY - startDodoY) * t
            )

        GUI.CompactStatus.Position =
            Vector2.new(
                X + currentW - 22,
                Y + currentH / 2
            )

        if t >= 1 then
            break
        end

        task.wait()
    end

    setCompactVisible(false)
    setNormalVisible(true)

    GUI.Title.Position =
        Vector2.new(
            X + 22,
            Y + 17
        )

    COMPACT = false
    ANIMATING = false
end

-- ==========================================
-- END KEY
-- ==========================================

local END_KEY = 0x23
local wasPressed = false

task.spawn(function()

    while RUNNING do

        local pressed =
            iskeypressed(END_KEY)

        if pressed
        and not wasPressed
        and not ANIMATING then

            if COMPACT then
                animateToFull()
            else
                animateToCompact()
            end
        end

        wasPressed = pressed

        task.wait(0.01)
    end
end)
